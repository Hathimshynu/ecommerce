# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ShopKart

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shopkart

# Redis (caching)
REDIS_URL=redis://localhost:6379

# Elasticsearch (product search). Falls back to PostgreSQL search if unreachable.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=products
# ELASTICSEARCH_API_KEY=

# Auth – use a long random string in production (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-secret-string-of-32-chars-min

# Admin image uploads are stored here (mount a persistent volume in production)
UPLOAD_DIR=./uploads

# Razorpay payments (leave empty to run UPI/Card payments in simulated mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Protects /api/cron/expire-orders (cancels unpaid online orders after 30 min)
CRON_SECRET=

# Seeded admin account (npm run db:seed)
ADMIN_EMAIL=admin@shopkart.dev
ADMIN_PASSWORD=Admin@12345
